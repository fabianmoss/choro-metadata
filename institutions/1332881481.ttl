<urn:uuid:institutions/1332881481> a melod:Institution;
    schema:name "Irmãos Vitale";
    schema:address "Rua Visc. de Pirajá, 82 - 1201 - Ipanema - Rio de Janeiro - RJ, 22410-904, Brazil";
    schema:location <urn:uuid:places/1800036311>;
    owl:sameAs <https://www.wikidata.org/wiki/Q118906848>, <https://viaf.org/viaf/49159939597125252802>, <https://id.loc.gov/authorities/names/n85106094>, <https://edicoes.vitale.com.br/contato>;
    schema:foundingDate _:beac61753-cf50-c137-a3c7-26df50436d11;
    schema:description "The Brazilian music publishing house Irmãos Vitale (Irmãos Vitale Editores Ltda.), founded in November 1923 by the brothers Emílio, Vicente, Affonso, João and José Vitale, specialised in the publication and distribution of scores, books and other music material.  It published works by Zequinha de Abreu, Pixinguinha, Cartola, Ary Barroso, Ernesto Nazareth and Chiquinha Gonzaga, among many others, and was one of the first publishers of Brazilian popular music scores.  It has offices in Rio de Janeiro (Rua Visc. de Pirajá, 82 - Ipanema) and in São Paulo (Rua Raposo Tavares, 85 - Jd. das Acácias).  The identification of the house comes from its own site and from Wikidata; the acervo names it only in the field “Cópia” of the scores.".

_:beac61753-cf50-c137-a3c7-26df50436d11 a melod:ExactDate;
    melod:isodate "1923-11-01"^^xsd:date;
    schema:description "November 1923; the day of the month is not documented.".
