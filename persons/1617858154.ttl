<urn:uuid:persons/1617858154> a melod:Person;
    schema:familyName "Júnior";
    schema:givenName "Baptista";
    schema:gender "male";
    schema:hasOccupation "Letrista";
    schema:description "<p>The acervo records the lyrics of “A Araponga e a Juriti” as “Letra de Baptista Junior”, with no record in the encyclopedia. The identification is provisional: it may be the poet Júlio Baptista de Mesquita (1881-1947) or the composer Batista Júnior (1894-1943).</p>";
    dct:conformsTo melod:Person.
